FROM python:3.14-slim@sha256:cd89c30eda26ee911a4611b18680086e0ea42e6f5f8cbe653d07fa7958c9cec8
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements-service.txt ./
RUN python -m pip install --no-cache-dir -r requirements-service.txt \
    && python -m pip check \
    && groupadd --gid 10001 service \
    && useradd --uid 10001 --gid service --create-home --no-log-init service
# Application files stay root-owned; runtime secrets are mounted, never copied.
COPY shopee_affiliate/ ./shopee_affiliate/
COPY shopee_service/ ./shopee_service/
COPY shopee_contracts.py ./
USER 10001:10001

CMD ["python", "-m", "shopee_service.worker"]
